# Where the editor finds the orchestrator.
#
# Copy to `.env.local` and adjust. `.env.local` is gitignored.
#
# Leave this EMPTY to use the Vite dev proxy: the browser calls `/api` on the same origin and
# Vite forwards it to `http://localhost:5181` (see `vite.config.ts`). That needs no CORS and is
# the right setting for everyday dev against the Node server.
#
# Set it to the deployed Worker to talk to production data:
#
#   VITE_ORCHESTRATOR_URL=https://rakit-orchestrator.rakit-aliy.workers.dev
#
# Two things must then be true, or the browser blocks every request:
#   1. This origin must appear in the Worker's `CORS_ALLOWED_ORIGINS`.
#   2. The Worker must be deployed with `LLM_KITA_API_KEY` set via `wrangler secret put`.
#
# A mismatch shows up in the editor as "Tidak dapat menghubungi server" — see the rail footer,
# which distinguishes a failed load from a loaded one.

VITE_ORCHESTRATOR_URL=

# -------------------------------------------------------------------------------------------------
# Shared token (containment, not authentication)
# -------------------------------------------------------------------------------------------------
#
# Sent as `X-Rakit-Token` on every API request. Must match the orchestrator's RAKIT_SHARED_TOKEN.
#
# `npm run dev:all` sets this for you from the root `.env`, so you normally do not write it here.
# It is documented in case you run the editor on its own.
#
# THIS IS NOT A SECRET. Vite inlines every `VITE_*` variable into the bundle at build time, so
# this value ships to every browser that loads the editor and is readable in DevTools. It raises
# the cost of casual abuse and does nothing against someone who looks. Real auth replaces it.
VITE_RAKIT_TOKEN=
