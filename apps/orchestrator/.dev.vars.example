# Local secrets for `wrangler dev` (the Worker path).
#
# Copy to `.dev.vars` in this same directory and fill in the values:
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is gitignored. The real API key must never be written into `wrangler.toml`,
# which IS committed — non-secret configuration belongs there, secrets belong here.
#
# Deployed Workers do not read this file. Use `wrangler secret put <NAME>` for the deployed
# value; the two are independent stores and updating one does not update the other.
#
# IMPORTANT: `npm run dev:all` does NOT read this file. That script starts `server.ts`, a plain
# Node process, and reads the root `.env` instead. This file only matters when you run
# `wrangler dev` yourself.
#
# `server.ts` does, however, read the [vars] block of `wrangler.toml` — a database binding and
# `LLM_KITA_BASE_URL` are not things you should have to write down twice. Only the values below
# that are genuinely secrets, or that differ from `wrangler.toml`, belong in the root `.env`.

LLM_KITA_API_KEY=isi-api-key-dari-llm-kita-com

# The shared token every API request must present, except /health and the CORS preflight.
#
# This is containment, not authentication: the editor is a browser app, so any token it sends
# is readable in DevTools. It stops crawlers and scanners, not people. Leave it empty locally
# if you prefer the API to be open on localhost.
RAKIT_SHARED_TOKEN=

# Whether /generate and /revise are served. Only the exact string `true` enables them.
#
# Off by default. That is deliberate for the deployed Worker — an endpoint that spends quota
# should not be reachable until auth exists. Locally you will usually want it on.
FEATURE_GENERATE_ENABLED=false
