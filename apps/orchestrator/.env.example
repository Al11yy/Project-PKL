# Copy to .env and fill in. Never commit .env — .gitignore already covers it.
#
# Get these three from the LLM-Kita account that issued the token.
# LLM_KITA_BASE_URL is the API root, without a trailing slash and without
# /chat/completions — the client appends that path itself.
LLM_KITA_API_KEY=
LLM_KITA_BASE_URL=
LLM_KITA_MODEL=

# Optional. Defaults shown. Timeout is in milliseconds.
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS_GENERATE=8000
LLM_MAX_TOKENS_REVISE=12000
PORT=5181
