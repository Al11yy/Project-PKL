# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Local runtime artefacts — screenshot output only; the harness that writes
# them (.shots/*.mjs) is hand-written source and stays tracked.
# The leading **/ matters: a pattern containing a slash is anchored to the
# .gitignore's own directory, so bare ".shots/*.png" would miss apps/editor/.
**/.shots/*.png
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment — never commit secrets or credentials
.env
.env.*
!.env.example

# Wrangler's local secret file. It is NOT matched by the `.env.*` pattern above, and it holds
# the LLM API key in plaintext — exactly the file that must never reach a commit.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler's local state: the local D1 replica, caches, and build output. Machine-specific and
# rebuildable from `migrations/`, so it is never committed.
.wrangler/

# MCP server config — embeds Atlassian credentials
.mcp.json
!.mcp.json.example
*.pem
*.key
.npmrc.local

# Editor / tooling state
.vscode/
.idea/
coverage/
.cache/

# Screenshots from the browser smoke tests
tools/shots/
