# Root environment for local development.
#
# Copy to `.env` and fill in what you need:
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way — it holds API tokens. This example file is
# committed, so it carries key names and explanations only, never values.

# ---------------------------------------------------------------------------------------------
# Confluence (used by the /confluence tooling, not by the running app)
# ---------------------------------------------------------------------------------------------
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# ---------------------------------------------------------------------------------------------
# LLM-Kita — the model provider
# ---------------------------------------------------------------------------------------------
#
# Set this to run `npm run dev:all` against the real model. When it is absent the harness starts
# `tools/fake-llm.mjs` instead, so the editor works without spending quota.
#
# The API is at https://api.llm-kita.com/api/v1 — NOT llm-kita.com, which is the marketing site
# and answers every POST with 405. The path must include /api/v1; the client appends
# /chat/completions to it.
LLM_KITA_API_KEY=
LLM_KITA_BASE_URL=https://api.llm-kita.com/api/v1
LLM_KITA_MODEL=auto

# ---------------------------------------------------------------------------------------------
# Shared token and the generation switch
# ---------------------------------------------------------------------------------------------
#
# Generate a token locally and keep it out of git:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,''))"
#
# `dev:all` forwards this to the orchestrator as RAKIT_SHARED_TOKEN and to the editor as
# VITE_RAKIT_TOKEN, so both halves always agree. Leave it empty to run with the API open.
#
# THIS IS NOT AUTHENTICATION. Vite inlines VITE_RAKIT_TOKEN into the browser bundle, so anyone
# who opens DevTools can read it. It deters crawlers and scanners and nothing else. Real auth is
# still required before the editor is published.
RAKIT_SHARED_TOKEN=

# Whether /generate and /revise are served. Only the exact string `true` enables them; every
# other value, including this empty one, leaves them disabled with 503 FEATURE_DISABLED.
#
# Default off so that a deployment cannot spend quota by accident. Turn it on locally only.
FEATURE_GENERATE_ENABLED=false
